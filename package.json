{
  "name": "lai-siangtho",
  "productName": "Lai Siangtho",
  "version": "26.9.30",
  "description": "Bible reading and study \u2014 web (PWA) and desktop (Electron) from one codebase",
  "author": {
    "name": "Lai Siangtho"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laisiangtho/lab.git"
  },
  "homepage": "https://github.com/laisiangtho/lab",
  "desktopName": "org.laisiangtho.app.desktop",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:package": "electron-vite build && electron-builder",
    "test": "node --test \"test/*.test.js\" \"test/core/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/app.test.mjs test/e2e/restart.test.mjs test/e2e/layout.test.mjs test/e2e/locale.test.mjs",
    "test:perf": "npm run build && node test/e2e/perf.mjs",
    "test:desktop": "npm run desktop:build && node test/e2e/desktop.mjs",
    "test:all": "npm test && npm run test:e2e",
    "aliases": "node scripts/aliases.mjs",
    "version:stamp": "node scripts/version.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  }
}
